{
  "server_url": "http://192.168.2.204:55000/api/v1",
  "agent_id": "ad8579bd-9cfe-4e28-abdf-821d5e3e4e68",
  "agent_name": "Linux-Agent",
  "heartbeat_interval": 3,
  "policy_sync_interval": 60,
  "monitoring": {
    "file_system": true,
    "monitored_paths": [
      "/home",
      "/var/www",
      "/opt/data"
    ],
    "exclude_paths": [
      "/home/*/.cache",
      "/home/*/.local/share",
      "/home/*/snap"
    ],
    "file_extensions": [
      ".pdf",
      ".docx",
      ".xlsx",
      ".txt",
      ".csv",
      ".json",
      ".xml",
      ".sql",
      ".conf"
    ]
  },
  "quarantine": {
    "enabled": true,
    "folder": "/opt/cybersentinel/quarantine"
  },
  "classification": {
    "enabled": true,
    "max_file_size_mb": 10
  }
}